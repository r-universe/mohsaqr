	url = https://github.com/mohsaqr/cooccure
[submodule "idiographic"]
	path = idiographic
	url = https://github.com/mohsaqr/idiographic
[submodule "lagdynamics"]
	path = lagdynamics
	url = https://github.com/mohsaqr/lagdynamics
[submodule "psychnets"]
	path = psychnets
	url = https://github.com/mohsaqr/psychnet
[submodule "snakeplot"]
	path = snakeplot
