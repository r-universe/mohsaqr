	path = .registry
	url = https://github.com/mohsaqr/mohsaqr.r-universe.dev
	branch = HEAD
[submodule "Nestimate"]
	path = Nestimate
	url = https://github.com/mohsaqr/Nestimate
[submodule "bibnets"]
	path = bibnets
	url = https://github.com/mohsaqr/bibnets
[submodule "cooccur"]
	path = cooccur
	url = https://github.com/mohsaqr/cooccur
[submodule "snakeplot"]
	path = snakeplot
	url = https://github.com/mohsaqr/snakeplot
