[submodule ".registry"]
	path = .registry
	url = https://github.com/mohsaqr/mohsaqr.r-universe.dev
	branch = HEAD
[submodule "Nestimate"]
	path = Nestimate
	url = https://github.com/mohsaqr/Nestimate
[submodule "bibnets"]
	path = bibnets
	url = https://github.com/mohsaqr/bibnets
[submodule "cooccure"]
	path = cooccure
	url = https://github.com/mohsaqr/cooccure
[submodule "lagseq"]
	path = lagseq
	url = https://github.com/mohsaqr/lagseq
[submodule "snakeplot"]
	path = snakeplot
	url = https://github.com/mohsaqr/snakeplot
